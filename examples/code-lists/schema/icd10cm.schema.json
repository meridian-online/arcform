{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meridian://code-lists/icd10cm",
  "title": "ICD-10-CM normalised code list",
  "description": "Column contract for dist/icd10cm.parquet. finetype validates each row's values (as text) against these patterns.",
  "type": "object",
  "properties": {
    "code":   { "type": "string", "pattern": "^[A-Z][0-9A-Z]{2,6}$", "description": "3–7 char ICD-10-CM code (no dot)." },
    "title":  { "type": "string", "minLength": 1, "maxLength": 512 },
    "level":  { "type": "string", "pattern": "^[1-5]$", "description": "1 category … 5 full 7-char code." },
    "parent": { "type": ["string", "null"], "description": "Parent code; null for 3-char categories (roots)." },
    "as_of":  { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Snapshot date (ISO 8601)." }
  },
  "required": ["code", "title", "level", "as_of"]
}
