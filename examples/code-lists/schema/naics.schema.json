{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meridian://code-lists/naics",
  "title": "NAICS normalised code list",
  "description": "Column contract for dist/naics.parquet. finetype validates each row's values (as text) against these patterns.",
  "type": "object",
  "properties": {
    "code":   { "type": "string", "pattern": "^([0-9]{2,6}|[0-9]{2}-[0-9]{2})$", "description": "2–6 digit NAICS code, or a sector range like 31-33." },
    "title":  { "type": "string", "minLength": 1, "maxLength": 512 },
    "level":  { "type": "string", "pattern": "^[1-5]$", "description": "1 sector … 5 national industry." },
    "parent": { "type": ["string", "null"], "description": "Parent code; null for sectors (roots)." },
    "as_of":  { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Snapshot date (ISO 8601)." }
  },
  "required": ["code", "title", "level", "as_of"]
}
